# ==============================================================================
# Shareable Stickies — Environment Variables Reference (v 0.1.0)
# Configure during install via .env, setup.sh, or the web Admin Settings modal
# ==============================================================================

PORT=3000
NODE_ENV=development

# Paste at-rest encryption secret (32+ character hex string or passphrase for AES-256-GCM)
ENCRYPTION_SECRET="replace-with-a-secure-32-byte-hex-or-passphrase-string"

# ------------------------------------------------------------------------------
# 1. UI Theme Mode: dark (default), light, sepia
# ------------------------------------------------------------------------------
DEFAULT_THEME=dark

# ------------------------------------------------------------------------------
# 2. Allow Public Creation of Stickies: default is off (false)
# When false (default), users must sign in or register to create stickies.
# When true, unauthenticated guest visitors can create public/unlisted stickies.
# ------------------------------------------------------------------------------
ALLOW_ANONYMOUS_CREATION=false
ALLOW_PUBLIC_STICKIES=false

# ------------------------------------------------------------------------------
# 3. OIDC Single Sign-On (SSO) Settings
# ------------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_PROVIDER_NAME="Enterprise SSO"
OIDC_ISSUER_URL="https://accounts.google.com"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ALLOWED_DOMAINS="*"
OIDC_REQUIRE_OIDC_ONLY=false

# ------------------------------------------------------------------------------
# 4. Image & Attachment Storage: local (default), cloudinary, s3
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
DATA_DIR="./data"

# Cloudinary Configuration (Active when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative Cloudinary URL shorthand:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Amazon S3 / S3-Compatible Configuration (Active when STORAGE_DRIVER=s3)
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional custom S3 endpoint for MinIO, Cloudflare R2, Wasabi, or Backblaze:
AWS_ENDPOINT=""

# ------------------------------------------------------------------------------
# 5. Administrator Account Credentials
# Initial admin username and password (or change via web Admin Settings modal)
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
